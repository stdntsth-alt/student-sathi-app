dynamic currentNote(
  List<NotesRecord> notes,
  String noteId,
) {
  final n = notes
      .where((n) => n.reference.id == noteId ?? "")
      .firstOrNull
      ?.snapshotData;
  return n == null
      ? {}
      : {
          "title": n.title,
          "subject": n.subject,
          "unit": n.unit,
          "total_pages": n.total_pages,
          "content_body": n.content_body
        };
}
